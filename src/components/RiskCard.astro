---
import { icon } from '../lib/icons.mjs';
const { risk } = Astro.props;
const g = risk.gov;
---
<a class={`card on-color d-${risk.domain.color}`} href={risk.href}>
  <Fragment set:html={icon(`symbol-${risk.slug}.svg`, { cls: 'sym' })} />
  <h3>{risk.name}</h3>
  <p class="desc">{risk.summary}</p>
  <div class="foot">
    <span class="cap">{risk.isMultiplier ? 'Risk multiplier' : risk.domain.name}</span>
    <ul class="pills">
      {risk.isMultiplier
        ? <li class="pill">Strength: {risk.strength.toLowerCase()}</li>
        : <li class="pill">Likelihood: {risk.L.label.toLowerCase()}</li>}
      <li class="pill">Governance: {g.maturity.toLowerCase()} <span aria-hidden="true">&nbsp;{g.trend}</span><span class="visually-hidden">, {g.trend_label.toLowerCase()}</span></li>
    </ul>
  </div>
</a>
